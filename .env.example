# Server Port & App URL
PORT=5000
NODE_ENV="development"
APP_URL="http://localhost:3000"

# Email Notifications (Resend / SMTP)
RESEND_API_KEY="re_placeholder_12345"
EMAIL_FROM="Nest Care Connect <support@nestcareconnect.com>"

# Payment Provider Configuration (demo | razorpay)
PAYMENT_PROVIDER="demo"
VITE_PAYMENT_PROVIDER="demo"

# Payment Gateways - India (Razorpay)
# Frontend Public Key (Vite prefix required - must match RAZORPAY_KEY_ID)
VITE_RAZORPAY_KEY_ID="rzp_test_actual_key_here"

# Backend Server Credentials (Server only - never exposed to frontend)
RAZORPAY_KEY_ID="rzp_test_actual_key_here"
RAZORPAY_KEY_SECRET="actual_test_secret_here"
RAZORPAY_WEBHOOK_SECRET="actual_webhook_secret_here"

# Shipping Provider Configuration (nimbuspost)
