# Database (Neon PostgreSQL connection string)
DATABASE_URL="postgresql://neondb_owner:npg_placeholder@ep-dry-pond-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://neondb_owner:npg_placeholder@ep-dry-pond-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication
JWT_SECRET="nest_care_connect_super_secret_jwt_key_2026_production"
