# Database (Neon Serverless PostgreSQL connection strings)
# DATABASE_URL: Pooled endpoint (-pooler) for application queries via PgBouncer
DATABASE_URL="postgresql://neondb_owner:npg_placeholder@ep-dry-pond-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30&pool_timeout=30&connection_limit=10"
# DIRECT_URL: Direct unpooled endpoint for Prisma schema migrations and pushes
DIRECT_URL="postgresql://neondb_owner:npg_placeholder@ep-dry-pond-123456.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# JWT Authentication
JWT_SECRET="your_strong_random_jwt_secret_minimum_32_characters_here"
JWT_EXPIRES_IN="7d"

# Server Port & App URL
PORT=5000
NODE_ENV="development" # Set to "production" in production hosting environments
APP_URL="http://localhost:3000" # Set to your deployed frontend domain (e.g. https://nestcareconnect.com or https://nest-care-connect.vercel.app)
FRONTEND_URL="" # Optional additional allowed frontend domain
CLIENT_URL="" # Optional additional allowed frontend domain

# Frontend API Configuration (Vite environment variables)
# If frontend & backend are deployed on the SAME domain (e.g. unified Vercel deployment), leave blank to use relative "/api"
# If backend is deployed separately (e.g. Render / Railway / ECS), set to full backend URL: https://api.nestcareconnect.com/api
VITE_API_BASE_URL=""

# Email Notifications (Resend / SMTP)
RESEND_API_KEY="re_placeholder_12345"
EMAIL_FROM="Nest Care Connect <support@nestcareconnect.com>"

# Payment Provider Configuration (razorpay)
PAYMENT_PROVIDER="razorpay"
VITE_PAYMENT_PROVIDER="razorpay"

# Payment Gateways - India (Razorpay)
# For Production: use rzp_live_xxxxxxxxxxxxx
# For Development: use rzp_test_xxxxxxxxxxxxx
# Frontend Public Key (Vite prefix required - must match RAZORPAY_KEY_ID)
VITE_RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxx"

# Backend Server Credentials (Server only - NEVER exposed to frontend or Git)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_live_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_live_webhook_secret"

# Shipping Provider Configuration (nimbuspost)
# Configured for NimbusPost Test / Sandbox mode by default
SHIPPING_PROVIDER="nimbuspost"
NIMBUSPOST_ENV="test"
NIMBUSPOST_API_BASE_URL="https://api.nimbuspost.com"
NIMBUSPOST_BASE_URL="https://api.nimbuspost.com/v1"
NIMBUSPOST_EMAIL="your_nimbuspost_email@example.com"
NIMBUSPOST_PASSWORD="your_nimbuspost_password_here"
NIMBUSPOST_API_KEY="npk_placeholder_api_key_here"
NIMBUSPOST_SECRET="placeholder_secret_here"
NIMBUSPOST_TOKEN=""
NIMBUSPOST_PICKUP_LOCATION="Warehouse Hub 1"
NIMBUSPOST_PICKUP_PINCODE="560001"

# International - UAE & USA (Stripe)
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder"

# Object Storage (Cloudflare R2 / AWS S3)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="nest-care-connect"
STORAGE_PUBLIC_URL=""

# WhatsApp Business Communication & Cloud API Configuration
# Business WhatsApp phone number for customer orders and concierge support
WHATSAPP_BUSINESS_PHONE_NUMBER="+918921342411"
VITE_WHATSAPP_PHONE_NUMBER="+918921342411"
# Meta WhatsApp Cloud API credentials (leave blank for Click-to-Chat fallback)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
